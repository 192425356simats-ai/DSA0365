import re
sentence = input("Enter sentence: ")
words = sentence.split()
for word in words:
    if re.match(r'.*ing$', word):
        tag = "VBG"
    elif re.match(r'.*ed$', word):
        tag = "VBD"
    elif re.match(r'.*ly$', word):
        tag = "RB"
    else:
        tag = "NN"
    print(word, "/", tag)
